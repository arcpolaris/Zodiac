<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>LiteEntitySystem</id>
    <version>1.2.2</version>
    <title>LiteEntitySystem</title>
    <authors>Ruslan Pyrch</authors>
    <license type="expression">Apache-2.0</license>
    <licenseUrl>https://licenses.nuget.org/Apache-2.0</licenseUrl>
    <readme>README.md</readme>
    <projectUrl>https://github.com/RevenantX/LiteEntitySystem</projectUrl>
    <description>Pure C# HighLevel API for multiplayer games using .NET Standard 2.1</description>
    <releaseNotes>https://github.com/RevenantX/LiteEntitySystem/releases/tag/1.2.1</releaseNotes>
    <copyright>Ruslan Pyrch</copyright>
    <repository type="git" url="https://github.com/RevenantX/LiteEntitySystem" commit="1b008a8c3140c419ca6c5474689dbd355d8ece1b" />
    <dependencies>
      <group targetFramework="net8.0">
        <dependency id="K4os.Compression.LZ4" version="1.3.8" exclude="Build,Analyzers" />
        <dependency id="LiteNetLib" version="2.0.1" exclude="Build,Analyzers" />
      </group>
      <group targetFramework=".NETStandard2.1">
        <dependency id="K4os.Compression.LZ4" version="1.3.8" exclude="Build,Analyzers" />
        <dependency id="LiteNetLib" version="2.0.1" exclude="Build,Analyzers" />
      </group>
    </dependencies>
  </metadata>
</package>